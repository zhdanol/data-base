SELECT songs_name, songs_duration
FROM songs
WHERE songs_duration = (select max(songs_duration) from Songs);

SELECT songs_name, songs_duration
FROM songs
WHERE songs_duration > 210;

SELECT collection_id, collection_year 
FROM collection  
WHERE collection between 2018 and 2020;

SELECT musicians   
FROM musicians   
WHERE musicians not LIKE '% %';

